# B on the card = Play (never a dead end): prompt exit 255 -> honest cancel/idle log,
# no engine dispatch, stock launcher runs.
desc launch card: B/cancel -> Play, honest action=play log, stock runs
invoke wrap
config paired
wifi up
sdfile+ Roms/GBA/Zelda.gba
engine 0|101\t2026-07-01 10:00\tBrick\t32KB\tCURRENT\nLOCAL=current
engine 0|RESULT mode=list-states n=0
pick 255
expect_exit 0
expect_trace PROMPT[Zelda.gba]
expect_trace STOCK GBA rom=
expect_trace_absent ENGINE --sync-save
expect_log card action=play (cancel/idle)
