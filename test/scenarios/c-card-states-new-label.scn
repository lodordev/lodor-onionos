# known=0 = a state this device has not seen: the row gets "(new)" and the card action
# itself reads "Restore a save state (new)".
desc launch card states: known=0 -> "(new)" row + "(new)" card action label
invoke wrap
config paired
wifi up
sdfile+ Roms/GBA/Zelda.gba
engine 0|LOCAL=none
engine 0|LISTSTATE id=44 slot=1 compat=1 known=0 age=300 size=100 origin=lodor/onion/mgba/armhf why="-" name="fresh.state"\nRESULT mode=list-states n=1
pick 1
pick 255
expect_exit 0
expect_trace Restore a save state (new)
expect_trace "fresh.state"  -  5m ago (new)
expect_trace STOCK GBA rom=
