# Launch card (task #80): server saves exist -> the card shows Play + Restore latest save.
# Choosing Play dispatches NOTHING to the engine and hands off to the stock launcher.
desc launch card: saves offered, Play chosen -> no engine dispatch, stock launcher runs
invoke wrap
config paired
wifi up
sdfile+ Roms/GBA/Zelda.gba
engine 0|101\t2026-07-01 10:00\tBrick\t32KB\tCURRENT\nLOCAL=current
engine 0|RESULT mode=list-states n=0 reason=no-manifest
pick 0
expect_exit 0
expect_trace ENGINE --list-saves
expect_trace ENGINE --list-states
expect_trace PROMPT[Zelda.gba]
expect_trace Restore latest save
expect_trace STOCK GBA rom=
expect_trace_absent ENGINE --sync-save
expect_trace_absent ENGINE --pull-state
expect_log card action=PLAY
