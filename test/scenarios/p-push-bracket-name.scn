# Glob metacharacters in the ROM stem must not break save-change detection: find -iname
# takes a GLOB, so an unescaped "Zelda [v1]" stem was a character class that never matched
# its own save file — changed saves were silently never pushed (fixed 2026-07-22).
desc push: bracketed ROM name -> save change detected, --sync-save fires
invoke wrap
config paired
wifi up
romarg Roms/GBA/Zelda [v1].gba
sdfile+ Roms/GBA/Zelda [v1].gba
stockwrites Saves/CurrentProfile/saves/mGBA/Zelda [v1].srm
engine 0|LOCAL=current
engine 0|RESULT mode=list-states n=0
engine 0|RESULT pushed=1
expect_exit 0
expect_trace ENGINE --sync-save
expect_log save-push rc=0
expect_file_absent App/LodorSync/data/pending-saves.txt
