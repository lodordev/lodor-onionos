#!/bin/sh
# infoPanel stub — OnionOS's message panel (MI-GFX). FAITHFUL blocking model:
#   --persistent : block until /tmp/dismiss_info_panel appears (what the real binary does),
#                  so ui_show/ui_dismiss's background+flag+reap dance is exercised for real.
#   --auto       : draw + wait a button — exits immediately here (a scripted button press).
# Traced as PANEL lines; scenarios pin titles/messages against them.
set -u
T="${LODOR_SIM_DIR:?}/trace.log"
title=""; msg=""; mode=once
while [ $# -gt 0 ]; do
	case "$1" in
		--title)      title="${2:-}"; shift 2 ;;
		--message)    msg="${2:-}"; shift 2 ;;
		--persistent) mode=persistent; shift ;;
		--auto)       mode=auto; shift ;;
		*) shift ;;
	esac
done
echo "PANEL mode=$mode title='$title' msg='$msg'" >> "$T"
if [ "$mode" = persistent ]; then
	i=0
	while [ ! -e /tmp/dismiss_info_panel ] && [ "$i" -lt 400 ]; do
		/bin/sleep 0.05; i=$((i + 1))
	done
fi
exit 0
